---
import { getEntry, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';

const entry = await getEntry('articles', 'rideshare-02-driver-suii');
if (!entry) throw new Error('article entry not found: rideshare-02-driver-suii');
const { Content } = await render(entry);
---

<ArticleLayout
  title={entry.data.title}
  description={entry.data.description}
  category={entry.data.category}
  dataAsOf={entry.data.dataAsOf}
  sources={[
    { name: entry.data.sourceName, url: entry.data.sourceUrl },
    { name: '参議院常任委員会調査室・特別調査室「タクシー輸送の担い手の確保とその在り方」(立法と調査 No.467)', url: 'https://www.sangiin.go.jp/japanese/annai/chousa/rippou_chousa/backnumber/2024pdf/20240627018.pdf' },
  ]}
  publishedDate={entry.data.publishedDate}
>
  <Content />
</ArticleLayout>
